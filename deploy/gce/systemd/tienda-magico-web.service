[Unit]
Description=Pueblo Mágico storefront (Next.js)
Documentation=https://github.com/itsJASPERr/tienda-magico
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tienda
Group=tienda
WorkingDirectory=/opt/tienda-magico
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
EnvironmentFile=-/etc/tienda-magico/storefront.env
ExecStart=/usr/bin/npm run start:web
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=mixed

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/tienda-magico

StandardOutput=journal
StandardError=journal
SyslogIdentifier=tienda-magico-web

[Install]
WantedBy=multi-user.target
