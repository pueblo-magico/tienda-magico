[Unit]
Description=Pueblo Mágico CMS (Payload / Next.js)
Documentation=https://github.com/itsJASPERr/tienda-magico
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=tienda
Group=tienda
WorkingDirectory=/opt/tienda-magico/apps/cms
Environment=NODE_ENV=production
Environment=PORT=4000
Environment=HOSTNAME=127.0.0.1
EnvironmentFile=-/etc/tienda-magico/cms.env
# Payload often loads apps/cms/.env — keep a symlink or copy from EnvironmentFile in deploy.
ExecStart=/usr/bin/npm run start
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=mixed

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/tienda-magico/apps/cms /opt/tienda-magico/apps/cms/media

StandardOutput=journal
StandardError=journal
SyslogIdentifier=tienda-magico-cms

[Install]
WantedBy=multi-user.target
