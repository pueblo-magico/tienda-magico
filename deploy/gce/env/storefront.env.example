# Copy to /etc/tienda-magico/storefront.env (or PAYLOAD_CMS_API_KEY=TM_ENV_DIR/storefront.env)
# chmod 600 — contains secrets

NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1

# Public storefront URL (https recommended in production)
NEXT_PUBLIC_SITE_URL=https://shop.example.com

# Commerce
COMMERCE_PROVIDER=payload
PAYLOAD_ECOMMERCE_URL=https://cms.example.com
PAYLOAD_ECOMMERCE_API_KEY=
PAYLOAD_ECOMMERCE_API_KEY_COLLECTION=users
PAYLOAD_ECOMMERCE_CURRENCY=USD
PAYLOAD_ECOMMERCE_AMOUNT_IS_CENTS=true
PAYLOAD_ECOMMERCE_CHECKOUT_PATH=/checkout
PAYLOAD_ECOMMERCE_DEFAULT_LOCALE=en
PAYLOAD_ECOMMERCE_FALLBACK_LOCALE=en

# Optional Shopify (if COMMERCE_PROVIDER=shopify)
# SHOPIFY_STORE_DOMAIN=
# SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# SHOPIFY_API_VERSION=2025-01

# Checkout / Mercado Pago
CHECKOUT_PROVIDER=mercado-pago
MERCADOPAGO_ACCESS_TOKEN=TEST-replace-me
MERCADOPAGO_SANDBOX=false
# MERCADOPAGO_WEBHOOK_URL=https://shop.example.com/api/checkout/webhooks/mercado-pago

# CMS content (homepage pages API — often same host as ecommerce)
PAYLOAD_CMS_URL=https://cms.example.com
PAYLOAD_CMS_API_KEY=
CMS_HOME_PAGE_SLUG=home