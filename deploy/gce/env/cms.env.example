# Copy to /etc/tienda-magico/cms.env
# chmod 600 — contains secrets

NODE_ENV=production
PORT=4000
HOSTNAME=127.0.0.1

# Postgres on the same VM (docker compose binds 127.0.0.1:5433)
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5433/tienda_magico_cms

# Long random string (e.g. openssl rand -base64 48)
PAYLOAD_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# Public CMS URL (media absolute URLs + admin)
NEXT_PUBLIC_SERVER_URL=https://cms.example.com
PAYLOAD_PUBLIC_SERVER_URL=https://cms.example.com

# Storefront origins allowed to call REST (comma-separated, no trailing slash).
# On a split-VM deploy this must be the public shop origin (https://shop…).
CORS_ORIGINS=https://shop.example.com

PAYLOAD_ECOMMERCE_DEFAULT_LOCALE=en
PAYLOAD_ECOMMERCE_FALLBACK_LOCALE=en
