# Copy to /etc/tienda-magico/cms.env
# chmod 600 — contains secrets

NODE_ENV=production
PORT=4000
HOSTNAME=0.0.0.0

# Postgres is reached over the private Docker Compose network. Port 5433 is
# only the optional loopback port for tools running directly on the VM.
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@postgres:5432/tienda_magico_cms

# Long random string (e.g. openssl rand -base64 48)
PAYLOAD_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# Public CMS URL (media absolute URLs + admin)
NEXT_PUBLIC_SERVER_URL=https://cms.example.com
PAYLOAD_PUBLIC_SERVER_URL=https://cms.example.com

# Storefront origins allowed to call REST (comma-separated, no trailing slash)
CORS_ORIGINS=https://shop.example.com

PAYLOAD_ECOMMERCE_DEFAULT_LOCALE=es
PAYLOAD_ECOMMERCE_FALLBACK_LOCALE=es

STOREFRONT_REVALIDATION_URL=https://shop.example.com/api/revalidate/catalog
STOREFRONT_REVALIDATION_SECRET=CHANGE_ME_SHARED_REVALIDATION_SECRET
