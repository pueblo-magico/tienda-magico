# Non-secret deployment inputs. Set these as GitHub Environment variables with
# the same names for each environment (staging now, production later).
GCP_PROJECT_ID=your-gcp-project
GCP_REGION=us-central1
GCP_ZONE=us-central1-a
GCP_INSTANCE=tienda-staging
ARTIFACT_REPOSITORY=tienda
STOREFRONT_HOST=staging-shop.example.com
CMS_HOST=staging-cms.example.com

# Build-time values. These must not contain private credentials.
NEXT_PUBLIC_SITE_URL=https://staging-shop.example.com
PAYLOAD_ECOMMERCE_URL=https://staging-cms.example.com
PAYLOAD_CMS_URL=https://staging-cms.example.com
NEXT_PUBLIC_CMS_URL=https://staging-cms.example.com
CMS_MEDIA_ORIGIN=https://staging-cms.example.com
NEXT_PUBLIC_SERVER_URL=https://staging-cms.example.com
PAYLOAD_PUBLIC_SERVER_URL=https://staging-cms.example.com
