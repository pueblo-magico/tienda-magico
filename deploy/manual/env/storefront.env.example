NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

NEXT_PUBLIC_SITE_URL=https://staging-shop.example.com

COMMERCE_PROVIDER=payload
PAYLOAD_ECOMMERCE_URL=https://staging-cms.example.com
PAYLOAD_ECOMMERCE_API_KEY=
PAYLOAD_ECOMMERCE_API_KEY_COLLECTION=users
PAYLOAD_ECOMMERCE_CURRENCY=ARS
PAYLOAD_ECOMMERCE_AMOUNT_IS_CENTS=true
PAYLOAD_ECOMMERCE_CHECKOUT_PATH=/checkout
PAYLOAD_ECOMMERCE_DEFAULT_LOCALE=es
PAYLOAD_ECOMMERCE_FALLBACK_LOCALE=es

PAYLOAD_CMS_URL=https://staging-cms.example.com
PAYLOAD_CMS_API_KEY=
CMS_HOME_PAGE_SLUG=home

CHECKOUT_PROVIDER=mercado-pago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_SANDBOX=true
MERCADOPAGO_WEBHOOK_URL=https://staging-shop.example.com/api/checkout/webhooks/mercado-pago
