# Active commerce backend: shopify | payload
COMMERCE_PROVIDER=shopify

# Optional public site URL (used for Payload checkout links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Shopify Storefront API (COMMERCE_PROVIDER=shopify)
# -----------------------------------------------------------------------------
# Domain only, without protocol — e.g. your-store.myshopify.com
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=shpat_storefront_token_here
SHOPIFY_API_VERSION=2025-01

# -----------------------------------------------------------------------------
# Payload Ecommerce self-hosted (COMMERCE_PROVIDER=payload)
# -----------------------------------------------------------------------------
# Base URL of your Payload app (no trailing slash)
PAYLOAD_ECOMMERCE_URL=http://localhost:4000
# Optional API key for server-side access (Users collection API key)
PAYLOAD_ECOMMERCE_API_KEY=
PAYLOAD_ECOMMERCE_API_KEY_COLLECTION=users
# REST prefix (Payload default /api)
PAYLOAD_ECOMMERCE_API_PREFIX=/api
# Default currency code matching Payload currencies config
PAYLOAD_ECOMMERCE_CURRENCY=USD
# Payload price fields are typically stored in minor units (cents)
PAYLOAD_ECOMMERCE_AMOUNT_IS_CENTS=true
# Collection slugs (plugin defaults)
PAYLOAD_ECOMMERCE_PRODUCTS_SLUG=products
PAYLOAD_ECOMMERCE_VARIANTS_SLUG=variants
PAYLOAD_ECOMMERCE_CARTS_SLUG=carts
# Optional categories/collections collection used for getCollections()
PAYLOAD_ECOMMERCE_COLLECTIONS_SLUG=categories
# Checkout destination used for Cart.checkoutUrl
PAYLOAD_ECOMMERCE_CHECKOUT_PATH=/checkout
# Or absolute checkout URL override:
# PAYLOAD_ECOMMERCE_CHECKOUT_URL=http://localhost:3000/checkout
# Relationship population depth
PAYLOAD_ECOMMERCE_DEPTH=2

# Locale for Payload catalog content (matches apps/cms localization)
PAYLOAD_ECOMMERCE_DEFAULT_LOCALE=en
PAYLOAD_ECOMMERCE_FALLBACK_LOCALE=en

# -----------------------------------------------------------------------------
# Payload CMS content API (homepage / pages / globals)
# Reuses PAYLOAD_ECOMMERCE_* when unset.
# -----------------------------------------------------------------------------
# PAYLOAD_CMS_URL=http://localhost:4000
# PAYLOAD_CMS_API_KEY=
# CMS_HOME_PAGE_SLUG=home

# -----------------------------------------------------------------------------
# Checkout / payments (provider-agnostic)
# CHECKOUT_PROVIDER=mercado-pago | commerce-redirect
# Auto-selects mercado-pago when MERCADOPAGO_ACCESS_TOKEN is set.
# -----------------------------------------------------------------------------
CHECKOUT_PROVIDER=mercado-pago

# Mercado Pago Checkout Pro (Preferences API)
# https://www.mercadopago.com/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=TEST-your-access-token
# Optional aliases: MP_ACCESS_TOKEN
# Force sandbox init_point (defaults to true when token starts with TEST-)
MERCADOPAGO_SANDBOX=true
# MERCADOPAGO_API_BASE_URL=https://api.mercadopago.com
# MERCADOPAGO_STATEMENT_DESCRIPTOR=PUEBLOMAGICO
# MERCADOPAGO_BINARY_MODE=false
# Public webhook override (defaults to {SITE}/api/checkout/webhooks/mercado-pago)
# MERCADOPAGO_WEBHOOK_URL=
# CHECKOUT_WEBHOOK_URL=

