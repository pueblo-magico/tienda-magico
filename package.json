{
  "name": "tienda-magico",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "dev:web": "next dev --turbopack",
    "dev:cms": "npm --prefix apps/cms run dev",
    "build:web": "next build --turbopack",
    "build:cms": "npm --prefix apps/cms run build",
    "start:web": "next start",
    "start:cms": "npm --prefix apps/cms run start",
    "lint:cms": "npm --prefix apps/cms run lint",
    "db:cms:up": "npm --prefix apps/cms run db:up",
    "db:cms:down": "npm --prefix apps/cms run db:down",
    "deploy:gce": "bash deploy/gce/deploy.sh"
  },
  "dependencies": {
    "next": "15.5.23",
    "next-intl": "^4.13.6",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
