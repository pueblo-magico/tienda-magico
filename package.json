{
  "name": "tienda-magico",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:all": "node --import ./tests/register.mjs --test \"tests/*.test.mjs\" && vitest run && playwright test",
    "test:legacy": "node --import ./tests/register.mjs --test \"tests/*.test.mjs\"",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui --coverage.enabled",
    "test:coverage": "vitest run --coverage",
    "test:report": "vitest run --coverage --reporter=default --reporter=html",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:ci": "npm run test:ci:unit && npm run test:ci:e2e",
    "test:ci:unit": "vitest run --coverage --reporter=default --reporter=html --reporter=json",
    "test:ci:e2e": "playwright test",
    "test:catalog": "node --import ./tests/register.mjs --test tests/catalog.test.mjs",
    "test:task-04": "node --import ./tests/register.mjs --test tests/catalog.test.mjs tests/product-publication.test.mjs tests/catalog-revalidation.test.mjs tests/sellable-items.test.mjs",
    "test:task-03": "node --import ./tests/register.mjs --test tests/catalog.test.mjs tests/product-publication.test.mjs tests/catalog-revalidation.test.mjs",
    "test:deploy": "node --test tests/deployment-runtime-env.test.mjs",
    "dev:web": "next dev --turbopack",
    "dev:cms": "npm --prefix apps/cms run dev",
    "build:web": "next build --turbopack",
    "build:cms": "npm --prefix apps/cms run build",
    "start:web": "next start",
    "start:cms": "npm --prefix apps/cms run start",
    "lint:cms": "npm --prefix apps/cms run lint",
    "db:cms:up": "npm --prefix apps/cms run db:up",
    "db:cms:down": "npm --prefix apps/cms run db:down",
    "build-artifact": "node deploy/manual/build-artifact.mjs",
    "deploy:gce": "bash deploy/gce/deploy.sh"
  },
  "dependencies": {
    "lucide-react": "^1.44.0",
    "next": "16.3.0",
    "next-intl": "^4.13.6",
    "react": "19.1.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/ui": "^5.0.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
