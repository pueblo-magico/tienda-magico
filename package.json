{
  "name": "tienda-magico",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typecheck:cms": "npm --prefix apps/cms run typecheck",
    "test:catalog": "node --import ./tests/register.mjs --test tests/catalog.test.mjs",
    "test:task-04": "node --import ./tests/register.mjs --test tests/catalog.test.mjs tests/product-publication.test.mjs tests/catalog-revalidation.test.mjs tests/sellable-items.test.mjs",
    "test:task-05": "node --import ./tests/register.mjs --test tests/supplier-agreements.test.mjs tests/catalog.test.mjs tests/sellable-items.test.mjs",
    "test:task-05:db": "node --import ./tests/register.mjs --test --test-force-exit apps/cms/tests/supplier-agreements.db.test.mjs",
    "test:ci": "node --import ./tests/register.mjs --test tests/github-ci.test.mjs tests/supplier-agreements.test.mjs tests/catalog.test.mjs tests/sellable-items.test.mjs tests/cash-waiting.test.mjs tests/deployment-config.test.mjs tests/deployment-branches.test.mjs tests/deployment-jobs.test.mjs tests/deployment-runtime-env.test.mjs",
    "test:task-03": "node --import ./tests/register.mjs --test tests/catalog.test.mjs tests/product-publication.test.mjs tests/catalog-revalidation.test.mjs",
    "test:deploy": "node --test tests/deployment-runtime-env.test.mjs",
    "dev:web": "next dev --turbopack",
    "dev:cms": "npm --prefix apps/cms run dev",
    "build:web": "next build --turbopack",
    "build:cms": "npm --prefix apps/cms run build",
    "start:web": "next start",
    "start:cms": "npm --prefix apps/cms run start",
    "lint:cms": "npm --prefix apps/cms run lint",
    "db:cms:up": "npm --prefix apps/cms run db:up",
    "db:cms:down": "npm --prefix apps/cms run db:down",
    "build-artifact": "node deploy/manual/build-artifact.mjs",
    "deploy:gce": "bash deploy/gce/deploy.sh"
  },
  "dependencies": {
    "@pueblo-magico/react-ui": "^0.5.0",
    "lucide-react": "^1.44.0",
    "next": "16.3.0",
    "next-intl": "^4.13.6",
    "react": "19.1.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
