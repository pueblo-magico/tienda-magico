# Postgres (see docker-compose.yml — default local port 5433)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/tienda_magico_cms

# Required Payload secret (generate a long random string)
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public URL of this CMS (used for media URLs / CORS context)
NEXT_PUBLIC_SERVER_URL=http://localhost:4000
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:4000

# Storefront origin(s) allowed to call the REST API (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Locale for Payload catalog content (matches apps/cms localization)
PAYLOAD_ECOMMERCE_DEFAULT_LOCALE=en
PAYLOAD_ECOMMERCE_FALLBACK_LOCALE=en

