# Postgres (see docker-compose.yml — default local port 5433)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/tienda_magico_cms

# Required Payload secret (generate a long random string)
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public URL of this CMS (used for media URLs / CORS context)
NEXT_PUBLIC_SERVER_URL=http://localhost:4000
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:4000

# Optional immediate storefront cache refresh. Use the same secret in the storefront.
STOREFRONT_REVALIDATION_URL=http://localhost:3000/api/revalidate/catalog
STOREFRONT_REVALIDATION_SECRET=replace-with-a-long-random-secret

# Storefront origin(s) allowed to call the REST API (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Locale for Payload catalog content (matches apps/cms localization)
PAYLOAD_ECOMMERCE_DEFAULT_LOCALE=es
PAYLOAD_ECOMMERCE_FALLBACK_LOCALE=es

# Pagos a proveedores. Usar credenciales exclusivas para Payouts. Las
# notificaciones son solo una señal: el CMS consulta la transacción autenticada.
MERCADOPAGO_PAYOUTS_ACCESS_TOKEN=TEST-reemplazar-con-token-de-payouts
MERCADOPAGO_PAYOUTS_TEST_MODE=true
# Debe ser HTTPS y terminar en /api/supplier-payouts/webhooks/mercado-pago.
MERCADOPAGO_PAYOUTS_WEBHOOK_URL=https://cms.example.test/api/supplier-payouts/webhooks/mercado-pago
