# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

.tmp
outputs

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/artifacts/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# monorepo / cms
apps/cms/node_modules
apps/cms/.next
apps/cms/media/**
!apps/cms/media/.gitkeep
apps/cms/.env
apps/cms/.env.*
!apps/cms/.env.example
